<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Hotel Bookings -->
        <record id="seq_hotel_booking" model="ir.sequence">
            <field name="name">Hotel Booking Sequence</field>
            <field name="code">hotel.booking</field>
            <field name="prefix">BK-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Sequence for Housekeeping Tasks -->
        <record id="seq_hotel_housekeeping_task" model="ir.sequence">
            <field name="name">Housekeeping Task Sequence</field>
            <field name="code">hotel.housekeeping.task</field>
            <field name="prefix">HK-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>

        <!-- Sequence for Maintenance Requests -->
        <record id="seq_hotel_maintenance_request" model="ir.sequence">
            <field name="name">Maintenance Request Sequence</field>
            <field name="code">hotel.maintenance.request</field>
            <field name="prefix">MNT-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
    </data>
</odoo>

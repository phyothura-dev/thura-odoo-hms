<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Window Action -->
    <record id="hotel_guest_action" model="ir.actions.act_window">
        <field name="name">Guests</field>
        <field name="res_model">hotel.guest</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first Guest Profile!
            </p>
        </field>
    </record>

    <!-- List View -->
    <record id="hotel_guest_tree_view" model="ir.ui.view">
        <field name="name">hotel.guest.list</field>
        <field name="model">hotel.guest</field>
        <field name="arch" type="xml">
            <list string="Guests">
                <field name="name"/>
                <field name="phone"/>
                <field name="gender"/>
                <field name="national_id"/>
                <field name="nationality"/>
                <field name="vip_type" widget="badge"
                       decoration-warning="vip_type == 'vip'"
                       decoration-info="vip_type == 'corporate'"
                       decoration-muted="vip_type == 'normal'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="hotel_guest_form_view" model="ir.ui.view">
        <field name="name">hotel.guest.form</field>
        <field name="model">hotel.guest</field>
        <field name="arch" type="xml">
            <form string="Guest Profile">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_bills"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-credit-card">
                            <field name="bill_count" widget="statinfo" string="Folios / Bills"/>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <label for="name" string="Guest Full Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. U Ba / Mg Mg"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Contact &amp; Identification">
                            <field name="phone"/>
                            <field name="gender"/>
                            <field name="national_id"/>
                            <field name="nationality"/>
                        </group>
                        <group string="Guest Classification &amp; Spending">
                            <field name="vip_type"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="total_spent" widget="monetary" class="fw-bold text-success"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes &amp; Preferences">
                            <field name="note" placeholder="Add special guest requests, allergies, or notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <!-- Chatter for Activity & History Logs -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="hotel_guest_kanban_view" model="ir.ui.view">
        <field name="name">hotel.guest.kanban</field>
        <field name="model">hotel.guest</field>
        <field name="arch" type="xml">
            <kanban default_group_by="vip_type" class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="phone"/>
                <field name="gender"/>
                <field name="national_id"/>
                <field name="vip_type"/>
                <field name="image"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex flex-row align-items-center">
                            <field name="image" widget="image" options="{'zoom': true, 'preview_image': 'image'}" class="o_kanban_image_fill_left me-2" style="max-width: 70px; max-height: 70px; object-fit: cover; border-radius: 50%;"/>
                            <div class="flex-grow-1">
                                <div class="fw-bold fs-5">
                                    <field name="name"/>
                                </div>
                                <div class="text-muted">
                                    <span>&#128222; </span><field name="phone"/>
                                </div>
                                <div class="text-muted small">
                                    <span>ID: </span><field name="national_id"/>
                                </div>
                                <div class="mt-1">
                                    <field name="vip_type" widget="badge"
                                           decoration-warning="vip_type == 'vip'"
                                           decoration-info="vip_type == 'corporate'"
                                           decoration-muted="vip_type == 'normal'"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="hotel_guest_search_view" model="ir.ui.view">
        <field name="name">hotel.guest.search</field>
        <field name="model">hotel.guest</field>
        <field name="arch" type="xml">
            <search string="Search Guests">
                <field name="name"/>
                <field name="phone"/>
                <field name="national_id"/>
                <field name="nationality"/>

                <filter string="VIP Guests" name="vip_guests" domain="[('vip_type', '=', 'vip')]"/>
                <filter string="Corporate Guests" name="corporate_guests" domain="[('vip_type', '=', 'corporate')]"/>

                <group expand="0" string="Group By">
                    <filter string="Guest Status" name="group_by_vip_type" context="{'group_by': 'vip_type'}"/>
                    <filter string="Gender" name="group_by_gender" context="{'group_by': 'gender'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
